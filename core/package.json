{
  "name": "@juhua/core",
  "version": "0.1.0",
  "type": "module",
  "description": "《酒话三国》规则引擎 —— 纯逻辑，零引擎依赖",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node --experimental-strip-types tools/validate.ts",
    "smoke": "node --experimental-strip-types tools/smoke.ts",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=Core --outfile=../prototype/core.bundle.js --log-level=warning"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}